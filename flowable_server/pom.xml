		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aiverse</groupId>
	<artifactId>spring</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
