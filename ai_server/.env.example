# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# RabbitMQ (same values as spring_server)
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
RABBITMQ_EXCHANGE=aiverse
RABBITMQ_REQUEST_QUEUE=aiverse.ai.requests
RABBITMQ_RESPONSE_QUEUE=aiverse.ai.responses
RABBITMQ_PREFETCH_COUNT=10

# Logging
OTEL_SERVICE_NAME=ai_server
OTEL_SERVICE_NAMESPACE=aiverse
OTEL_DEPLOYMENT_ENVIRONMENT=development
AIVERSE_LOG_LEVEL=INFO
AIVERSE_LOG_CONSOLE=true
AIVERSE_LOG_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


AIVERSE_GATEWAY_SECRET=
COMPOSIO_API_KEY=

COMPOSIO_TIMEOUT=30
COMPOSIO_MAX_RETRIES=2

INTEGRATIONS_ALLOWED_CALLBACK_ORIGINS=http://localhost:5173

TOOLS_SCHEDULED_SYNC_ENABLED=false
TOOLS_SYNC_TICK_SECONDS=60
TOOLS_SYNC_STARTUP_DELAY_SECONDS=30
DATABASE_CONNECTIONS_ENCRYPTION_KEY=KLKZjZw_Txl7ynrQP0nEbsjpD8ytU1rRe-kQLRSuLCk=


# YouTube Data API v3 key (transcripts work without it)
YOUTUBE_API_KEY=

# Where the Spring server runs (the AI server reads saved credentials from it); uses AI_INTERNAL_TOKEN
SPRING_SERVER_URL=
