# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# RabbitMQ (same values as spring_server)
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
RABBITMQ_EXCHANGE=aiverse
RABBITMQ_REQUEST_QUEUE=aiverse.ai.requests
RABBITMQ_RESPONSE_QUEUE=aiverse.ai.responses
RABBITMQ_PREFETCH_COUNT=10

# Logging
OTEL_SERVICE_NAME=ai_server
OTEL_SERVICE_NAMESPACE=aiverse
OTEL_DEPLOYMENT_ENVIRONMENT=development
AIVERSE_LOG_LEVEL=INFO
AIVERSE_LOG_CONSOLE=true
AIVERSE_LOG_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
