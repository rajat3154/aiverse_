
PORT=8081

OTEL_SERVICE_NAME=spring_server
OTEL_SERVICE_NAMESPACE=aiverse
AIVERSE_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development


GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp/v1/logs
GRAFANA_OTLP_USERNAME=
GRAFANA_OTLP_TOKEN=

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
RABBITMQ_EXCHANGE=aiverse
RABBITMQ_REQUEST_QUEUE=aiverse.ai.requests
RABBITMQ_RESPONSE_QUEUE=aiverse.ai.responses
RABBITMQ_PREFETCH_COUNT=10

API_KEY_ENCRYPTION_SECRET=

MASTER_SEED_FIRST_NAME=
MASTER_SEED_LAST_NAME=
MASTER_SEED_EMAIL=
MASTER_SEED_USERNAME=
MASTER_SEED_PASSWORD=

# token that enables POST /api/master (sent as X-Master-Token); leave empty to keep the endpoint disabled
MASTER_BOOTSTRAP_TOKEN=
