# Copy to .env (git-ignored) and fill in. Never commit real values.
PORT=8080

# Observability
OTEL_SERVICE_NAME=gateway_server
OTEL_SERVICE_NAMESPACE=aiverse
AIVERSE_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Grafana Cloud OTLP (endpoint must end in /v1/logs)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp/v1/logs
GRAFANA_OTLP_USERNAME=
GRAFANA_OTLP_TOKEN=

# Backend URLs
SPRING_SERVER_URL=http://localhost:8081
AI_SERVER_URL=http://localhost:8000
FLOWABLE_SERVER_URL=http://localhost:8082
FRONTEND_ORIGIN=http://localhost:5173


DATABASE_URL=jdbc:postgresql://localhost:5432/aiverse
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Redis (refresh-token store). Use the internal URL on Render, the external one (and an IP allowlist entry) locally.
REDIS_URL=
REDIS_KEY_PREFIX=aiverse:gateway

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


API_KEY_SECRET=